# Public URL of the site. Change this one value when moving to a custom domain.
NEXT_PUBLIC_SITE_URL=https://ivan-torrente.vercel.app

# From sanity.io/manage. Leave blank to preview locally with the resume content.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Server only. Sanity API token with Editor access, used by the seed script and photo upload.
SANITY_WRITE_TOKEN=
# Server only. Shared secret for the Sanity publish webhook.
SANITY_WEBHOOK_SECRET=

# Server only. Password for /login, which reveals the hero's photo upload button.
ADMIN_PASSWORD=
# Server only. At least 32 random characters, used to sign the session cookie.
SESSION_SECRET=
